{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/pages/home": [
        "./src/page-modules/home/_index.ts"
      ],
      "@/pages/home/assets": [
        "./src/page-modules/home/_assets.ts"
      ],
      "@/pages/newyork": [
        "./src/page-modules/newyork/_index.ts"
      ],
      "@/pages/newyork/assets": [
        "./src/page-modules/newyork/_assets.ts"
      ],
      "@/pages/shared/assets": [
        "./src/page-modules/shared/_assets.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
